# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/finances_db?schema=public"

# ─── JWT (RS256) ─────────────────────────────────────────────────────────────
# Generate with: npm run keys:generate
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# ─── Field-level encryption ───────────────────────────────────────────────────
# 32 random bytes as 64 hex chars — generate with: npm run keys:generate
FIELD_ENCRYPTION_KEY=
# Separate key for HMAC lookups (email search index)
FIELD_HMAC_KEY=

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:8081

# ─── Tokens ──────────────────────────────────────────────────────────────────
REFRESH_TOKEN_EXPIRY_DAYS=30
